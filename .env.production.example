# .env.production.example
# Copiar a .env.production y completar con valores reales.
# NUNCA commitear .env.production al repositorio.
# Configurar los mismos valores en GitHub Secrets para el pipeline de CI/CD.

# ─── Core ────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# Postgres (si usas docker-compose.prod.yml, DB_USER/DB_PASSWORD/DB_NAME
# se usan para construir DATABASE_URL internamente en el compose)
DATABASE_URL=postgresql://fitapp_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/fitapp_prod
DB_USER=fitapp_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=fitapp_prod

# Redis
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT — mínimo 32 caracteres aleatorios
# Generar con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_MINIMUM_32_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Dominio del frontend (sin trailing slash)
FRONTEND_URL=https://app.dominio.com

# ─── Pagos ───────────────────────────────────────────────────────────────────

# Stripe (producción — empieza con sk_live_)
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-CHANGE_ME
MERCADOPAGO_WEBHOOK_SECRET=CHANGE_ME

# Khipu
KHIPU_RECEIVER_ID=CHANGE_ME
KHIPU_SECRET=CHANGE_ME

# Kushki
KUSHKI_PUBLIC_MERCHANT_ID=CHANGE_ME
KUSHKI_PRIVATE_MERCHANT_ID=CHANGE_ME

# OpenPay
OPENPAY_MERCHANT_ID=CHANGE_ME
OPENPAY_API_KEY=CHANGE_ME
OPENPAY_IS_SANDBOX=false

# Flow
FLOW_API_KEY=CHANGE_ME
FLOW_SECRET_KEY=CHANGE_ME
FLOW_API_URL=https://www.flow.cl/api

# PayU
PAYU_MERCHANT_ID=CHANGE_ME
PAYU_API_KEY=CHANGE_ME
PAYU_ACCOUNT_ID=CHANGE_ME

# MACH Business
MACH_API_KEY=CHANGE_ME
MACH_WEBHOOK_SECRET=CHANGE_ME

# ─── Fintoc (conciliación bancaria) ──────────────────────────────────────────

FINTOC_SECRET_KEY=sk_live_CHANGE_ME
FINTOC_WEBHOOK_SECRET=CHANGE_ME

# ─── IA ──────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ─── Notificaciones ──────────────────────────────────────────────────────────

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=CHANGE_ME_SENDGRID_API_KEY
SMTP_FROM=noreply@dominio.com

# Alternativa: Resend
# RESEND_API_KEY=re_CHANGE_ME

# Push notifications (Expo)
EXPO_ACCESS_TOKEN=CHANGE_ME

# OneSignal (alternativa)
# ONESIGNAL_APP_ID=CHANGE_ME
# ONESIGNAL_API_KEY=CHANGE_ME

# ─── Storage ─────────────────────────────────────────────────────────────────
# Para subida de comprobantes de pago y avatares.
# Por defecto la API usa disco local (carpeta uploads/).
# Para producción con múltiples instancias, usar S3 o equivalente.

# S3_BUCKET=fithub-uploads-prod
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_ENDPOINT=https://s3.amazonaws.com  # o endpoint de Cloudflare R2, Supabase Storage, etc.

# ─── Monitoreo ───────────────────────────────────────────────────────────────

# Sentry (ver apps/api/src/lib/sentry.ts)
SENTRY_DSN=https://CHANGE_ME@oXXXXXX.ingest.sentry.io/XXXXXXX

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
# Variables NEXT_PUBLIC_* se exponen al browser — no poner secretos aquí.

NEXT_PUBLIC_API_URL=https://api.dominio.com/api
NEXT_PUBLIC_SENTRY_DSN=https://CHANGE_ME@oXXXXXX.ingest.sentry.io/XXXXXXX
