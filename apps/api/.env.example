# ─── Base de datos ────────────────────────────────────────────────────────────
# En producción: añadir ?sslmode=require al final
# Rol de la app: fitapp_app (sin superusuario ni BYPASSRLS, sujeto a RLS)
DATABASE_URL="postgresql://fitapp_app:APP_DB_PASSWORD@HOST:5432/fitapp_prod?sslmode=require"
# Admin (dueño de las tablas): migraciones, seed y scripts/setup-app-db-role
DATABASE_ADMIN_URL="postgresql://ADMIN_USER:ADMIN_PASSWORD@HOST:5432/fitapp_prod?sslmode=require"
# Contraseña que setup-app-db-role asigna a fitapp_app
APP_DB_PASSWORD="APP_DB_PASSWORD"

# ─── Cache / colas ────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# URL pública de la API (usada en webhooks de pasarelas)
PUBLIC_API_URL="https://api.tudominio.com"
BACKEND_URL="https://api.tudominio.com"

# ─── Autenticación ────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=""
# Opcionales (defaults: 15m / 7)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Sin trailing slash. Define el origen aceptado en CORS.
FRONTEND_URL="https://admin.tudominio.com"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET=""

# ─── Flow Chile ───────────────────────────────────────────────────────────────
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
FLOW_API_URL="https://www.flow.cl/api"     # sandbox: https://sandbox.flow.cl/api

# ─── Fintoc (conciliación bancaria Chile) ────────────────────────────────────
FINTOC_SECRET_KEY=""

# ─── IA (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Email (Resend SMTP) ──────────────────────────────────────────────────────
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_..."
SMTP_FROM="FitApp <no-reply@tudominio.com>"

# ─── Monitoreo ────────────────────────────────────────────────────────────────
SENTRY_DSN=""
GIT_COMMIT_SHA=""
