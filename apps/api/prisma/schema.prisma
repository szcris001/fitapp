generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  COACH
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  TRIAL
  INACTIVE
  EXPIRED
}

enum BookingStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
  ATTENDED
}

enum ClassFrequency {
  ONCE
  RECURRING
}

enum GymStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

model Gym {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  logoUrl            String?
  brandColors        Json      @default("{\"primary\":\"#6366f1\",\"secondary\":\"#4f46e5\",\"accent\":\"#818cf8\"}")
  bookingWindowDays  Int       @default(1)
  bookingCutoffMins  Int       @default(60)
  cancelCutoffMins   Int       @default(30)
  address            String?
  phone              String?
  email              String?
  instagram          String?
  facebook           String?
  termsAndConditions String?
  status             GymStatus @default(ACTIVE)
  subscriptionPlan   String    @default("trial")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users      User[]
  plans      Plan[]
  classTypes ClassType[]
  classes    Class[]
}

model User {
  id           String    @id @default(uuid())
  gymId        String?
  role         UserRole  @default(MEMBER)
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  birthDate    DateTime?
  gender       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  gym               Gym?                @relation(fields: [gymId], references: [id])
  memberships       Membership[]
  bookings          Booking[]
  rmRecords         RmRecord[]
  gymnasticProgress GymnasticProgress[]
}

model Plan {
  id           String   @id @default(uuid())
  gymId        String
  name         String
  description  String?
  priceCents   Int
  currency     String   @default("CLP")
  durationDays Int
  maxClasses   Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gym         Gym          @relation(fields: [gymId], references: [id])
  memberships Membership[]
  classTypes  ClassType[]  @relation("PlanClassTypes")
}

model Membership {
  id        String           @id @default(uuid())
  userId    String
  planId    String
  status    MembershipStatus @default(ACTIVE)
  startsAt  DateTime
  endsAt    DateTime
  paidAt    DateTime?
  pricePaid Int
  currency  String           @default("CLP")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
}

model ClassType {
  id          String   @id @default(uuid())
  gymId       String
  name        String
  description String?
  color       String?
  createdAt   DateTime @default(now())

  gym     Gym     @relation(fields: [gymId], references: [id])
  classes Class[]
  plans   Plan[]  @relation("PlanClassTypes")
}

model Class {
  id          String         @id @default(uuid())
  gymId       String
  classTypeId String
  coachId     String
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  frequency   ClassFrequency @default(ONCE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  gym       Gym       @relation(fields: [gymId], references: [id])
  classType ClassType @relation(fields: [classTypeId], references: [id])
  bookings  Booking[]
  wods      Wod[]
}

model Booking {
  id        String        @id @default(uuid())
  userId    String
  classId   String
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  class Class @relation(fields: [classId], references: [id])

  @@unique([userId, classId])
}

model Wod {
  id          String   @id @default(uuid())
  classId     String
  title       String?
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class     Class         @relation(fields: [classId], references: [id])
  movements WodMovement[]
}

model WodMovement {
  id           String  @id @default(uuid())
  wodId        String
  movementName String
  sets         Int?
  reps         Int?
  percentage   Int?
  notes        String?

  wod Wod @relation(fields: [wodId], references: [id])
}

model RmRecord {
  id           String   @id @default(uuid())
  userId       String
  movementName String
  weightKg     Float
  recordedAt   DateTime @default(now())
  notes        String?

  user User @relation(fields: [userId], references: [id])
}

model GymnasticProgress {
  id           String   @id @default(uuid())
  userId       String
  skillName    String
  milestone    String
  achievedAt   DateTime @default(now())
  notes        String?
  evidenceUrl  String?
  evidenceType String?

  user User @relation(fields: [userId], references: [id])
}
