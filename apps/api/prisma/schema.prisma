generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gym {
  id                     String                   @id @default(uuid())
  name                   String
  slug                   String                   @unique
  logoUrl                String?
  brandColors            Json                     @default("{\"accent\": \"#818cf8\", \"primary\": \"#6366f1\", \"secondary\": \"#4f46e5\"}")
  bookingWindowDays      Int                      @default(1)
  address                String?
  phone                  String?
  email                  String?
  instagram              String?
  facebook               String?
  termsAndConditions     String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  status                 GymStatus                @default(ACTIVE)
  subscriptionPlan       String                   @default("trial")
  bookingCutoffMins      Int                      @default(60)
  cancelCutoffMins       Int                      @default(30)
  bsaleBoletaTypeId      Int?
  bsaleFacturaTypeId     Int?
  bsaleOfficeId          Int?
  bsalePriceListId       Int?
  bsaleToken             String?
  dteCiudad              String?
  dteComuna              String?
  dteDireccion           String?
  dteGiro                String?
  dteRazonSocial         String?
  dteRut                 String?
  expiryReminderDays     Int                      @default(3)
  smtpFrom               String?
  smtpHost               String?
  smtpPass               String?
  smtpPort               Int?
  smtpUser               String?
  emailExpiryBody        String?
  emailExpirySubject     String?
  emailPaymentBody       String?
  emailPaymentSubject    String?
  sportTheme             String                   @default("neutral")
  paymentGateways        Json                     @default("{}")
  ownerEmail             String?
  deletedAt              DateTime?
  country                String                   @default("CL")
  movementLibrary        Json                     @default("[]")
  bankAccount            Json                     @default("{}")
  stripeCustomerId       String?
  attendanceMode         String                   @default("manual")
  gymLat                 Float?
  gymLng                 Float?
  gymRadiusMeters        Int                      @default(200)
  waitlistConfirmEnabled Boolean                  @default(false)
  waitlistConfirmMins    Int                      @default(30)
  weightRounding         Float                    @default(2.5)
  timezone               String                   @default("America/Santiago")
  bankMovements          BankMovement[]
  benchmarks             Benchmark[]
  benchmarkResults       BenchmarkResult[]
  classes                Class[]
  classTypes             ClassType[]
  fintocLink             FintocLink?
  fintocPaymentIntents   FintocPaymentIntent[]
  skills                 GymSkill[]
  subscriptions          GymSubscription[]
  subPayments            GymSubscriptionPayment[]
  plans                  Plan[]
  users                  User[]
  wods                   Wod[]
  wodResults             WodResult[]
}

model User {
  id                 String               @id @default(uuid())
  gymId              String?
  role               UserRole             @default(MEMBER)
  name               String
  email              String
  passwordHash       String
  phone              String?
  avatarUrl          String?
  birthDate          DateTime?
  gender             String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  source             String?
  pushToken          String?
  mustChangePassword Boolean              @default(false)
  stripeCustomerId   String?
  rut                String?
  bookings           Booking[]
  coachClasses       Class[]              @relation("CoachClasses")
  gymnasticProgress  GymnasticProgress[]
  memberships        Membership[]
  passwordResets     PasswordResetToken[]
  refreshTokens      RefreshToken[]
  rmRecords          RmRecord[]
  benchmarkResults   BenchmarkResult[]
  gym                Gym?                 @relation(fields: [gymId], references: [id])
  wodResultsRecorded WodResult[]          @relation("WodResultRecordedBy")
  wodResults         WodResult[]

  @@unique([gymId, email])
  @@unique([gymId, rut])
}

model Plan {
  id                  String       @id @default(uuid())
  gymId               String
  name                String
  description         String?
  priceCents          Int
  currency            String       @default("CLP")
  durationDays        Int
  maxClasses          Int?
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  autoRenewDaysBefore Int          @default(3)
  autoRenewEnabled    Boolean      @default(false)
  autoRenewMaxRetries Int          @default(2)
  isTrial             Boolean      @default(false)
  memberships         Membership[]
  gym                 Gym          @relation(fields: [gymId], references: [id])
  allowedClasses      Class[]      @relation("ClassAllowedPlans")
  classTypes          ClassType[]  @relation("PlanClassTypes")
}

model Membership {
  id                    String           @id @default(uuid())
  userId                String
  planId                String
  status                MembershipStatus @default(ACTIVE)
  startsAt              DateTime
  endsAt                DateTime
  paidAt                DateTime?
  pricePaid             Int
  currency              String           @default("CLP")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  paymentMethod         String?
  paymentNotes          String?
  invoiceNumber         Int?
  invoicePdfUrl         String?
  invoiceReceiverName   String?
  invoiceReceiverRut    String?
  invoiceType           String?
  transferReceiptUrl    String?
  transferStatus        String?
  autoRenew             Boolean          @default(false)
  autoRenewConsent      Boolean          @default(false)
  autoRenewFailures     Int              @default(0)
  nextAutoRenewAt       DateTime?
  stripePaymentMethodId String?
  bankMovements         BankMovement[]
  plan                  Plan             @relation(fields: [planId], references: [id])
  user                  User             @relation(fields: [userId], references: [id])

  @@index([userId, status, endsAt])
}

model ClassType {
  id          String           @id @default(uuid())
  gymId       String
  name        String
  description String?
  color       String?
  createdAt   DateTime         @default(now())
  discipline  String?
  classes     Class[]
  gym         Gym              @relation(fields: [gymId], references: [id])
  blocks      ClassTypeBlock[]
  wods        Wod[]
  plans       Plan[]           @relation("PlanClassTypes")
}

model ClassTypeBlock {
  id           String    @id @default(uuid())
  classTypeId  String
  order        Int
  name         String
  durationMins Int
  notes        String?
  isOptional   Boolean   @default(false)
  classType    ClassType @relation(fields: [classTypeId], references: [id], onDelete: Cascade)
}

model Class {
  id           String         @id @default(uuid())
  gymId        String
  classTypeId  String
  coachId      String
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int
  frequency    ClassFrequency @default(ONCE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  bookings     Booking[]
  classType    ClassType      @relation(fields: [classTypeId], references: [id])
  coach        User           @relation("CoachClasses", fields: [coachId], references: [id])
  gym          Gym            @relation(fields: [gymId], references: [id])
  allowedPlans Plan[]         @relation("ClassAllowedPlans")

  @@index([gymId, startsAt])
  @@index([gymId, classTypeId, startsAt])
}

model Booking {
  id              String        @id @default(uuid())
  userId          String
  classId         String
  status          BookingStatus @default(CONFIRMED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  confirmDeadline DateTime?
  attended        Boolean       @default(false)
  attendedAt      DateTime?
  class           Class         @relation(fields: [classId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([userId, classId])
  @@index([classId, status])
}

model Wod {
  id          String       @id @default(uuid())
  title       String?
  date        DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  classTypeId String
  gymId       String
  scoreType   WodScoreType @default(REPS)
  classType   ClassType    @relation(fields: [classTypeId], references: [id])
  gym         Gym          @relation(fields: [gymId], references: [id])
  blocks      WodBlock[]
  results     WodResult[]

  @@index([gymId, classTypeId])
  @@index([date])
}

model WodBlock {
  id        String        @id @default(uuid())
  wodId     String
  title     String?
  scheme    String?
  timecap   String?
  notes     String?
  order     Int           @default(0)
  wod       Wod           @relation(fields: [wodId], references: [id], onDelete: Cascade)
  movements WodMovement[]
}

model WodMovement {
  id             String   @id @default(uuid())
  movementName   String
  sets           Int?
  reps           Int?
  percentage     Int?
  notes          String?
  repScheme      String?
  scaledMovement String?
  weightRxF      Float?
  weightRxM      Float?
  weightRookieF  Float?
  weightRookieM  Float?
  weightScaleF   Float?
  weightScaleM   Float?
  roundWeights   Json?
  blockId        String
  order          Int      @default(0)
  block          WodBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model RmRecord {
  id           String   @id @default(uuid())
  userId       String
  movementName String
  weightKg     Float
  recordedAt   DateTime @default(now())
  notes        String?
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, movementName])
}

model GymnasticProgress {
  id           String   @id @default(uuid())
  userId       String
  skillName    String
  milestone    String
  achievedAt   DateTime @default(now())
  notes        String?
  evidenceType String?
  evidenceUrl  String?
  user         User     @relation(fields: [userId], references: [id])
}

model GymSkill {
  id          String              @id @default(uuid())
  gymId       String
  name        String
  description String?
  isActive    Boolean             @default(true)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  gym         Gym                 @relation(fields: [gymId], references: [id])
  milestones  GymSkillMilestone[]
}

model GymSkillMilestone {
  id               String   @id @default(uuid())
  skillId          String
  name             String
  order            Int      @default(0)
  requiresEvidence Boolean  @default(false)
  skill            GymSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model PlatformSettings {
  id                    String   @id @default("system")
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  smtpPass              String?
  smtpFrom              String?
  subExpiryReminderDays Int      @default(7)
  updatedAt             DateTime @updatedAt
}

model PlatformAsset {
  id        String   @id @default(uuid())
  key       String   @unique
  url       String
  filename  String
  sizeBytes Int      @default(0)
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  subject      String   @default("")
  body         String   @default("")
  placeholders Json     @default("[]")
  isSystem     Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FitAppPlan {
  id            String            @id @default(uuid())
  name          String
  slug          String            @unique
  description   String?
  priceCLP      Int               @default(0)
  priceUSD      Int               @default(0)
  durationDays  Int               @default(30)
  features      Json              @default("[]")
  isActive      Boolean           @default(true)
  isFree        Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  color         String?
  subscriptions GymSubscription[]
}

model GymSubscription {
  id                      String                   @id @default(uuid())
  gymId                   String
  planId                  String
  status                  GymSubscriptionStatus    @default(TRIAL)
  startsAt                DateTime
  endsAt                  DateTime
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  stripeCheckoutSessionId String?
  gym                     Gym                      @relation(fields: [gymId], references: [id])
  plan                    FitAppPlan               @relation(fields: [planId], references: [id])
  payments                GymSubscriptionPayment[]
}

model GymSubscriptionPayment {
  id             String           @id @default(uuid())
  gymId          String
  subscriptionId String?
  planId         String
  amount         Int
  currency       String           @default("CLP")
  country        String           @default("CL")
  gateway        String
  gatewayOrderId String?
  gatewayData    Json?
  status         GymPaymentStatus @default(PENDING)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  gym            Gym              @relation(fields: [gymId], references: [id])
  subscription   GymSubscription? @relation(fields: [subscriptionId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Benchmark {
  id           String              @id @default(uuid())
  externalId   String?             @unique
  gymId        String?
  nombre       String
  categoria    BenchmarkCategory
  año         Int?
  formato      String
  duracionMins Int?
  tiempoEstMin Int?
  descripcion  String?
  notas        String?
  isOfficial   Boolean             @default(true)
  createdAt    DateTime            @default(now())
  gym          Gym?                @relation(fields: [gymId], references: [id])
  movimientos  BenchmarkMovement[]
  resultados   BenchmarkResult[]
}

model BenchmarkMovement {
  id               String    @id @default(uuid())
  benchmarkId      String
  nombre           String
  repsEsquema      String?
  cargaRxKgHombre  Float?
  cargaRxKgMujer   Float?
  alturaRxCmHombre Int?
  alturaRxCmMujer  Int?
  cargaScaled      String?
  orden            Int       @default(0)
  benchmark        Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
}

model BenchmarkResult {
  id          String    @id @default(uuid())
  benchmarkId String
  userId      String
  gymId       String
  // Resultado: tiempo en segundos (For Time) o reps/rondas (AMRAP) o peso en kg (Weight)
  scoreType   String    // TIME | REPS | ROUNDS | WEIGHT | CUSTOM
  scoreValue  Float     // segundos, reps, rondas o kg
  scoreNotes  String?   // "10+5", "DNF", descripción libre
  isRx        Boolean   @default(true)
  recordedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym         Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([benchmarkId, gymId])
  @@index([userId])
}

model FintocLink {
  id            String           @id @default(uuid())
  gymId         String           @unique
  linkToken     String
  accountId     String
  accountNumber String?
  bankName      String?
  holderName    String?
  holderRut     String?
  currency      String           @default("CLP")
  status        FintocLinkStatus @default(ACTIVE)
  lastSyncAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  movements     BankMovement[]
  gym           Gym              @relation(fields: [gymId], references: [id])
}

model BankMovement {
  id                   String               @id @default(uuid())
  gymId                String
  fintocLinkId         String
  fintocMovementId     String               @unique
  amount               Int
  currency             String               @default("CLP")
  postedAt             DateTime
  description          String?
  senderRut            String?
  senderName           String?
  referenceCode        String?
  reconciliationStatus ReconciliationStatus @default(PENDING)
  membershipId         String?
  matchConfidence      String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  link                 FintocLink           @relation(fields: [fintocLinkId], references: [id])
  gym                  Gym                  @relation(fields: [gymId], references: [id])
  membership           Membership?          @relation(fields: [membershipId], references: [id])

  @@index([gymId, reconciliationStatus])
  @@index([gymId, postedAt])
}

model WodResult {
  id             String   @id @default(uuid())
  gymId          String
  wodId          String
  userId         String
  score          Float    @default(0)
  scoreText      String?
  rx             Boolean  @default(true)
  notes          String?
  recordedBy     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  gym            Gym      @relation(fields: [gymId], references: [id])
  recordedByUser User     @relation("WodResultRecordedBy", fields: [recordedBy], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  wod            Wod      @relation(fields: [wodId], references: [id], onDelete: Cascade)

  @@unique([wodId, userId])
  @@index([gymId, wodId])
  @@index([wodId, rx, score])
}

model FintocPaymentIntent {
  id             String          @id @default(uuid())
  gymId          String
  userId         String
  planId         String
  fintocIntentId String          @unique
  widgetUrl      String
  status         FintocPayStatus @default(PENDING)
  amountCents    Int
  membershipId   String?
  metadata       Json?
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  gym            Gym             @relation(fields: [gymId], references: [id])
}

enum WodScoreType {
  TIME
  REPS
  WEIGHT
  ROUNDS
  CUSTOM
}

enum BenchmarkCategory {
  GIRL
  HERO
  OPEN
  GAMES
  CUSTOM
}

enum UserRole {
  ADMIN
  COACH
  MEMBER
  SUPER_ADMIN
}

enum MembershipStatus {
  ACTIVE
  TRIAL
  INACTIVE
  EXPIRED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
  WAITLIST
  PENDING_CONFIRM
}

enum ClassFrequency {
  ONCE
  RECURRING
}

enum GymStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum GymSubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum GymPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FintocLinkStatus {
  ACTIVE
  REVOKED
  ERROR
}

enum FintocPayStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  CONFIRMED
  REJECTED
  MANUAL
}
