{
  "name": "@fitapp/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/generated', 'dist/generated', { recursive: true })\"",
    "start": "node dist/index.js",
    "seed": "ts-node prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@fastify/cors": "latest",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "latest",
    "@fastify/multipart": "latest",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^9.0.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "latest",
    "@prisma/client-runtime-utils": "7.5.0",
    "@sentry/node": "^8.0.0",
    "@stripe/stripe-js": "^8.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "bcryptjs": "latest",
    "dotenv": "latest",
    "expo-server-sdk": "^6.1.0",
    "fastify": "latest",
    "ioredis": "^5.11.1",
    "mercadopago": "^3.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "pg": "8.20.0",
    "stripe": "^20.4.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^4.1.5",
    "nodemon": "latest",
    "prisma": "latest",
    "ts-node": "latest",
    "typescript": "latest",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.32.1"
}
