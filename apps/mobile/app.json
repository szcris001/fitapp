{
  "expo": {
    "name": "Tribu-Box",
    "slug": "tribubox",
    "scheme": "tribubox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galería para subir tu foto de perfil y comprobantes de pago.",
        "NSPhotoLibraryAddUsageDescription": "Necesitamos acceso a tu galería para guardar fotos.",
        "NSCameraUsageDescription": "Necesitamos acceso a tu cámara para escanear códigos QR de asistencia y tomar tu foto de perfil.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "cl.tribubox.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "cl.tribubox.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tu galería para subir tu foto de perfil y comprobantes de pago.",
          "cameraPermission": "Necesitamos acceso a tu cámara para escanear QR de asistencia y tomar tu foto de perfil."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos acceso a tu cámara para escanear códigos QR de asistencia."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366f1",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Tribu-Box"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#080808"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ]
  }
}
