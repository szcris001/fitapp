# Copiar a .env.local (no se versiona) y ajustar a tu ambiente.
# Sin este archivo, la app usa la URL de producción por default (ver src/lib/api.ts).

# Ejemplos:
#   API local en la misma red Wi-Fi: http://192.168.1.50:3001
#   API local vía Expo tunnel:        https://xxxx.exp.direct (o la URL que imprima `expo start --tunnel`)
EXPO_PUBLIC_API_BASE=http://192.168.1.50:3001
